# Copy to .env and fill in. NEVER commit your real .env — it is gitignored.
# Every value below is optional: the app boots without any of them and you can
# explore it with the built-in dummy-data generator.

# ---------------------------------------------------------------------------
# cTrader Open API (only needed for live trade sync)
# Step-by-step guide, including how to apply and get approved: CTRADER-SETUP.md
# Short version: register an app at https://openapi.ctrader.com/apps, wait for it to
# become Active, then add your app's URL as a Redirect URI, e.g. http://localhost:5010/
# ---------------------------------------------------------------------------
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Optional. The in-app "Connect cTrader" button performs the OAuth flow and
# stores the token in data/ctrader_token.json, so you normally leave these blank.
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
# Force the API host instead of auto-detecting live vs demo:
# CTRADER_HOST=demo.ctraderapi.com

# Merge hotkey scale-ins opened within this many seconds into one logical trade.
CTRADER_GROUP_WINDOW=120

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# Display + day-boundary timezone (IANA name, DST handled automatically).
# Calendar days, daily-loss windows and displayed times use this; storage is UTC.
APP_TIMEZONE=Europe/London

# Seed realistic dummy trades on first start if the database is empty.
SEED_ON_START=false

# Backend autoreload — development only.
UVICORN_RELOAD=false

# ---------------------------------------------------------------------------
# Market data (free, keyless — no account required)
# ---------------------------------------------------------------------------
# Alternative Binance host if the main one is geo-blocked:
# BINANCE_BASE=https://data-api.binance.vision
BINANCE_BASE=https://api.binance.com

# Override the SQLite location if you want the DB somewhere else.
# DATABASE_URL=sqlite:////app/data/journal.db
